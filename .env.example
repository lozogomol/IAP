# Copia este archivo como .env (en local) y llena los valores.
# En Render se cargan en Environment > Environment Variables.

DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=iap-peaje.onrender.com

# Base de datos (Supabase o Render Postgres)
DATABASE_URL=

# Endpoint de inferencia (RunPod o Colab)
INFERENCE_URL=
INFERENCE_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=

# Tiempo real (Pusher)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Imágenes de evidencia
CLOUDINARY_URL=

# Agente conversacional (sin clave responde el agente por reglas; GEMINI_MODEL vacío = flash por defecto)
GEMINI_API_KEY=
GEMINI_MODEL=
# JWT de la app móvil (opcional: por defecto usa SECRET_KEY y 12 horas)
JWT_SECRET=
JWT_HORAS=12
